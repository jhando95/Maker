{
  "name": "maker",
  "version": "0.0.1",
  "description": "A cel-shaded freeform-building party game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shoot": "node tools/shoot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vite-node tools/bench.ts",
    "server": "vite-node server/serve.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhando95/Maker.git"
  },
  "bugs": {
    "url": "https://github.com/jhando95/Maker/issues"
  },
  "homepage": "https://github.com/jhando95/Maker#readme",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "private": true,
  "type": "module"
}
